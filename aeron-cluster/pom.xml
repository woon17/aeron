<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             http://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.aeron</groupId>
        <artifactId>aeron</artifactId>
        <version>1.51.0-SNAPSHOT</version>
    </parent>

    <artifactId>aeron-cluster</artifactId>

    <!-- NOTE: Test sources here require aeron-test-support (circular dep in Maven reactor).
         Tests are skipped during the reactor build. Run them individually after 'mvn install'. -->

    <dependencies>
        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-archive</artifactId>
        </dependency>
        <dependency>
            <groupId>io.aeron</groupId>
            <artifactId>aeron-annotations</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- SBE codec generation for main sources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>generate-cluster-codecs</id>
                        <phase>generate-sources</phase>
                        <goals><goal>run</goal></goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/generated-src"/>
                                <java classname="uk.co.real_logic.sbe.SbeTool"
                                      fork="true" failonerror="true">
                                    <sysproperty key="sbe.output.dir"
                                                 value="${project.build.directory}/generated-src"/>
                                    <sysproperty key="sbe.target.language" value="Java"/>
                                    <sysproperty key="sbe.validation.xsd"
                                                 value="${project.basedir}/src/main/resources/cluster/fpl/sbe.xsd"/>
                                    <sysproperty key="sbe.validation.stop.on.error" value="true"/>
                                    <classpath refid="maven.plugin.classpath"/>
                                    <arg value="${project.basedir}/src/main/resources/cluster/aeron-cluster-codecs.xml"/>
                                    <arg value="${project.basedir}/src/main/resources/cluster/aeron-cluster-mark-codecs.xml"/>
                                    <arg value="${project.basedir}/src/main/resources/cluster/aeron-cluster-node-state-codecs.xml"/>
                                </java>
                            </target>
                        </configuration>
                    </execution>
                </executions>
                <dependencies>
                    <dependency>
                        <groupId>uk.co.real-logic</groupId>
                        <artifactId>sbe-tool</artifactId>
                        <version>${sbe.version}</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!-- Register generated main source directory -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-generated-sources</id>
                        <phase>generate-sources</phase>
                        <goals><goal>add-source</goal></goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-src</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <!-- Unbind test compilation — test sources need aeron-test-support which
                         creates a circular Maven reactor dependency. Use 'mvn install' first. -->
                    <execution>
                        <id>default-testCompile</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>io.aeron.cluster</Automatic-Module-Name>
                            <Implementation-Title>Aeron</Implementation-Title>
                            <Implementation-Vendor>Adaptive Financial Consulting Limited</Implementation-Vendor>
                            <Implementation-Version>${project.version}</Implementation-Version>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
